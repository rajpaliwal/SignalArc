# Copy this file to `.env` and fill in real values for your machine.

APP_ENV=development

# Neo4j — local server (e.g. Neo4j Desktop or `docker run neo4j`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Postgres — local server
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/signalarc

# Auth — generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

# Bright Data SERP API — powers the Discover news feed. Get the key from
# Account Settings; the zone name is whatever SERP API zone you created there
# (check with: curl -H "Authorization: Bearer $SERP_API_KEY" https://api.brightdata.com/zone/get_active_zones)
SERP_API_KEY=changeme
SERP_ZONE=signal_arc

# OpenAI — story clustering/synthesis and what-if answers.
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-5-mini
DISCOVER_DEFAULT_LIMIT=5
